DATABASE_URL="postgresql://user:password@localhost:5432/meal_planner?schema=public"
PORT=3001
HOST="0.0.0.0"

# OpenAI API for recipe OCR and AI features
OPENAI_API_KEY="sk-..."

# Encryption key for storing secrets via Settings UI (32 bytes, hex or base64)
MEAL_PLANNER_ENCRYPTION_KEY="your-32-byte-key"

# Telegram bot
TELEGRAM_BOT_TOKEN="your-bot-token"
# Optional webhook settings for production
WEBHOOK_URL="https://your-domain.com"
WEBHOOK_PORT=3002

# Pi Meals (single host with a durable local volume; Node 26 tested)
PI_MEALS_SESSION_SECRET="replace-with-at-least-32-random-characters"
PI_MEALS_JAMES_PIN="choose-a-strong-private-pin"
PI_MEALS_MANON_PIN="choose-a-different-strong-private-pin"
PI_MEALS_ALLOWED_ORIGINS="http://localhost:3100,http://127.0.0.1:3100"
# Set true behind HTTPS. Keep UI and API on the same origin.
PI_MEALS_SECURE_COOKIE=false
PI_MEALS_RUNTIME_DIR="/Volumes/4TB Private/Offloaded/Agent Work/pi-meals-runtime"
PI_MEALS_WORK_DIR="/Volumes/4TB Private/Offloaded/Agent Work/pi-meals-instagram"
PI_MEALS_ASIDE_LOG_DIR="/Volumes/4TB Private/Offloaded/Agent Work/pi-meals-aside"
PI_MEALS_MODEL_PROVIDER=openai-codex
PI_MEALS_MODEL_ID=gpt-6.1-sol
# Existing authorised Pi installation; defaults to ~/.bun/install/global/node_modules/...
# PI_MEALS_PI_SDK_ROOT="/absolute/path/to/@earendil-works/pi-coding-agent"
# MANON_SWEEPER_PATH="/absolute/path/to/manon-chat-sweeper/pilot.py"
# Use installed Chrome, or omit when Playwright's Chromium is installed.
OCADO_BROWSER_CHANNEL=chrome
# Enable each only for attended, requested shopping after host verification.
PI_MEALS_CART_MUTATIONS_ENABLED=false
PI_MEALS_ASIDE_LAUNCH_ENABLED=false
# Optional absolute Aside CLI path for service hosts with a restricted PATH.
# PI_MEALS_ASIDE_BINARY="/absolute/path/to/aside"
# Run `aside settings save-sessions true` once to show shopping tasks in Aside.

# Optional private, unconfirmed setup notes; never commit personal source text.
PI_MEALS_HOUSEHOLD_NOTES_JSON=
